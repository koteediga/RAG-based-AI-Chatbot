# --- Required ---
# Get a free key at https://aistudio.google.com/apikey (GEMINI_API_KEY is also accepted)
GOOGLE_API_KEY=your_gemini_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=agentic-ai-index

# --- Optional (defaults shown) ---
PINECONE_NAMESPACE=agentic-ai
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Embeddings are truncated to 1536 dims to match the Pinecone index.
EMBEDDING_MODEL=gemini-embedding-001
# If you get a 404 "model not found", pick a current model from https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.1-flash-lite
# Gemini 3 models work best near their default temperature; raise to 1.0 if answers look odd.
LLM_TEMPERATURE=0.0
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# Refusal gate: if the best chunk's cosine similarity is below this, the LLM is never called.
# Starting values only: run `python -m scripts.calibrate_threshold` after ingestion and paste its output here.
MIN_RELEVANCE_SCORE=0.50
# Cosine range mapped onto 0..1 for the reported confidence score.
SCORE_FLOOR=0.40
SCORE_CEILING=0.80

# Ingestion throttling (helps stay inside free-tier rate limits)
EMBED_BATCH_SIZE=32
EMBED_SLEEP_SECONDS=1.0
